# RD WATCH - Configuración de Variables de Entorno (Ejemplo)
# Renombra este archivo a .env y ajusta los valores según tu entorno.

# Configuración de Base de Datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rdwatch
DB_USER=postgres
DB_PASS=tu_contraseña_aqui

# Seguridad y CORS
# Lista separada por comas de orígenes permitidos
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8002,http://127.0.0.1:8000
